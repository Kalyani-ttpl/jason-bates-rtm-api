/// Zenara's newer `condition_question`: one row per condition, questions as JSON.
/// Renamed because `ConditionQuestion` already holds the per-question library.
model ConditionQuestionnaire {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  name         String   @db.VarChar(255)
  questions    Json?
  condition_id BigInt?

  condition Condition?                       @relation(fields: [condition_id], references: [id])
  responses ConditionQuestionnaireResponse[]

  @@index([condition_id])
  @@index([name])
  @@map("condition_questionnaires")
}

model ConditionQuestionnaireResponse {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  response        Json?
  status          String    @db.VarChar(255)
  completed_at    DateTime? @db.Timestamptz
  question_id     BigInt?
  patient_id      BigInt
  completed_by_id BigInt?

  questionnaire ConditionQuestionnaire? @relation(fields: [question_id], references: [id], onDelete: Cascade)
  patient       Patient                 @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  completed_by  Provider?               @relation("questionnaire_completed_by", fields: [completed_by_id], references: [id])

  @@index([question_id])
  @@index([patient_id])
  @@map("condition_questionnaire_responses")
}

model CarePlanPatientReport {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
