  availabilityId    BigInt   @map("availability_id")
  windowIndex       Int?     @map("window_index")
  startsAt          DateTime @map("starts_at") @db.Timestamptz(3)
  duration          Int
  mode              String?
  chiefComplaint    String?  @map("chief_complaint")
  bodyPart          String?  @map("body_part")
  affectedSide      String?  @map("affected_side")
  notes             String?
  status            String
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  availability    Availability     @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  provider        Provider?        @relation("appointment_provider", fields: [providerId], references: [id], onDelete: Restrict)
  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointmentType AppointmentTypes @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)

  @@unique([availabilityId, startsAt, windowIndex])
  @@index([availabilityId, startsAt, status])
  @@index([providerId, startsAt, status])
  @@index([patientId, startsAt])
  @@index([startsAt, status])
  @@index([appointmentTypeId])
  @@map("appointments")
}

