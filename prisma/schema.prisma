  uuid               String    @unique @default(uuid()) @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz
  updated_at         DateTime? @updatedAt @db.Timestamptz
  assigned_at        DateTime? @default(now()) @db.Timestamptz
  responsible_person String?   @db.VarChar(50)
  program            String?   @db.VarChar(10)
  is_scheduled       Boolean?  @default(false)
  scheduled_at       DateTime? @db.Timestamptz
  scheduled_id       String?   @db.VarChar(150)
  scheduled_medium   String?   @db.VarChar(10)
  is_archived        Boolean?  @default(false)
  assessment_id      BigInt
  patient_id         BigInt
  assigned_by_id     BigInt?
  scheduled_by_id    BigInt?

  assessment Assessment          @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  patient    Patient             @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  response   AssessmentResponse?

  assigned_by  User?     @relation("assigned_assessment_assigned_by", fields: [assigned_by_id], references: [id])
  scheduled_by Provider? @relation("assigned_assessment_scheduled_by", fields: [scheduled_by_id], references: [id])

  @@index([assessment_id])
  @@index([patient_id])
  @@index([scheduled_at])
  @@map("assigned_assessments")
}

model AssessmentResponse {
  id                    BigInt    @id @default(autoincrement())
  uuid                  String    @unique @default(uuid()) @db.Uuid
  created_at            DateTime? @default(now()) @db.Timestamptz
  updated_at            DateTime? @updatedAt @db.Timestamptz
  responses             Json?     @db.JsonB
  response_at           DateTime? @db.Timestamptz
  review_at             DateTime? @db.Timestamptz
  review_note           String?   @db.Text
  is_new                Boolean?  @default(true)
  pdf_responses         String?   @db.Text
  response_pdf          String?   @db.VarChar(100)
  careplan_data         Json?     @db.JsonB
  careplan_response_ids Json?     @db.Json
  assignement_id        BigInt    @unique
  review_by_id          BigInt?

  assignment AssignedAssessment @relation(fields: [assignement_id], references: [id], onDelete: Cascade)

  nas_score Decimal? @db.Decimal(10, 2)
  review_by User?    @relation("assessment_response_review_by", fields: [review_by_id], references: [id])

  @@index([created_at])
  @@map("assessment_responses")
}

model Screening {
