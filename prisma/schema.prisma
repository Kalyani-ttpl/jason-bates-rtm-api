generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique @default(uuid()) @db.Uuid
  email               String?   @unique @db.VarChar(254)
  passwordHash        String?   @map("password_hash") @db.VarChar(128)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  username    String?   @unique @db.VarChar(150)
  firstName   String?   @map("first_name") @db.VarChar(255)
  lastName    String?   @map("last_name") @db.VarChar(255)
  picture     String?   @db.Text
  dateJoined  DateTime? @default(now()) @map("date_joined") @db.Timestamptz
  isSuperuser Boolean?  @default(false) @map("is_superuser")
  isStaff     Boolean?  @default(false) @map("is_staff")
  isActive    Boolean?  @default(true) @map("is_active")
  isProvider  Boolean?  @default(false) @map("is_provider")
  isPatient   Boolean?  @default(false) @map("is_patient")
  isDeleted   Boolean?  @default(false) @map("is_deleted")

  addedBy   Provider[] @relation("provider_added_by")
  deletedBy Provider[] @relation("provider_deleted_by")
  provider  Provider?  @relation("provider_user")

  patient         Patient?
  emailAddresses  EmailAddress[]
  notifications   UserNotification[]
  chatParticipant ChatParticipant?

  vitalsRecorded              Vital[]                  @relation("vital_recorded_by")
  patientCarePlansTransferred PatientCarePlan[]        @relation("patient_care_plan_transfer_by")
  encounterDetailsCreated     PatientEncounterDetail[] @relation("encounter_detail_created_by")
  encounterDetailsSigned      PatientEncounterDetail[] @relation("encounter_detail_signed_by")
  encounterDetailsUpdated     PatientEncounterDetail[] @relation("encounter_detail_updated_by")
  assessmentsAssigned         AssignedAssessment[]     @relation("assigned_assessment_assigned_by")
  assessmentReviews           AssessmentResponse[]     @relation("assessment_response_review_by")
  screeningsDone              Screening[]              @relation("screening_by")

  @@map("users")
}

model IcdCode {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(200)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  status         String  @default("active") @db.VarChar(20)
  isUnspecified  Boolean @default(false) @map("is_unspecified")
  isHipaaCovered String? @map("is_hipaa_covered") @db.VarChar(100)
  orderNumber    String? @map("order_number") @db.VarChar(255)
  conditionId    BigInt? @map("condition_id")

  condition Condition?         @relation(fields: [conditionId], references: [id])
  careplans CarePlanIcdCode[]

  @@index([description])
  @@index([status])
  @@index([conditionId])
  @@index([createdAt])
  @@map("icd_codes")
}

model CptCode {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(255)
  description String?   @db.VarChar(500)
  amount      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  category     String? @db.VarChar(100)
  globalPeriod Int?    @map("global_period")
  status       String  @default("active") @db.VarChar(20)
  isFavorite   Boolean @default(false) @map("is_favorite")

  @@index([description])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("cpt_codes")
}

model Address {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @db.Uuid
  patientId  BigInt?   @map("patient_id")
  employeeId BigInt?   @map("employee_id")
  type       String?
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?   @map("postal_code")
  country    String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient? @relation(fields: [patientId], references: [id])

  providerGroupsPhysical ProviderGroup[] @relation("physical_address")
  providerGroupsBilling  ProviderGroup[] @relation("billing_address")

  @@index([patientId])
  @@index([employeeId])
  @@index([city, state])
  @@index([postalCode])
  @@map("addresses")
}

model ProviderGroup {
  id                             BigInt    @id @default(autoincrement())
  uuid                           String    @unique @default(uuid()) @db.Uuid
  created_at                     DateTime? @default(now()) @db.Timestamptz
  updated_at                     DateTime? @updatedAt @db.Timestamptz
  group_name                     String?   @db.VarChar(255)
  group_npi                      String?   @unique @db.VarChar(10)
  code                           String?   @unique @db.VarChar(3)
  email                          String?   @db.VarChar(254)
  system_email                   String?   @unique @db.VarChar(254)
  system_email_verified          Boolean?  @default(false)
  phone                          String?   @db.VarChar(15)
  fax_id                         String?   @db.VarChar(20)
  website                        String?   @db.VarChar(200)
  speciality                     Json?     @db.Json
  status                         String?   @db.VarChar(10)
  picture                        String?   @db.Text
  bio                            String?   @db.Text
  caller_id                      String?   @db.VarChar(15)
  caller_id_verified             Boolean?  @default(false)
  physical_address_id            BigInt?
  billing_address_id             BigInt?
  device_vender_base_url         String?   @db.VarChar(200)
  show_revenue                   Boolean?  @default(false)
  timezone                       String?   @db.VarChar
  communication_logo             String?   @db.Text
  consent_logo                   String?   @db.Text
  report_logo                    String?   @db.Text
  disable_patient_emails         Boolean?  @default(false)
  disable_patient_notifications  Boolean?  @default(false)
  disable_patient_sms            Boolean?  @default(false)
  disable_provider_emails        Boolean?  @default(false)
  disable_provider_notifications Boolean?  @default(false)
  disable_provider_sms           Boolean?  @default(false)
  disable_patient_calls          Boolean?  @default(false)
  disable_call_recording         Boolean?  @default(false)

  physical_address Address? @relation("physical_address", fields: [physical_address_id], references: [id])
  billing_address  Address? @relation("billing_address", fields: [billing_address_id], references: [id])

  members                     ProviderGroupMember[]
  task_type                   TaskType[]
  tasks                       Task[]
  bulk_communication_template BulkCommunicationTemplate[]
  careplan                    CarePlan[]

  patients                     Patient[]
  assessments                  Assessment[]
  education_materials          EducationMaterial[]
  additional_consent_templates AdditionalConsentTemplate[]
  roles                        Role[]

  encounters           PatientEncounter[]
  call_recordings      GeneralCallRecording[]
  transfer_calls       ProviderGroupTransferCall[]
  vital_configurations VitalConfiguration[]

  @@index([physical_address_id])
  @@index([billing_address_id])
  @@index([created_at])
  @@map("provider_groups")
}

model Provider {
  id                   BigInt    @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz
  updated_at           DateTime? @updatedAt @db.Timestamptz
  first_name           String?   @db.VarChar(255)
  middle_name          String?   @db.VarChar(255)
  last_name            String?   @db.VarChar(255)
  display_name         String?   @db.VarChar(255)
  gender               String?   @db.VarChar(100)
  pronoun              String?   @db.VarChar(50)
  email                String?   @unique @db.VarChar(254)
  temparory_email      String?   @db.VarChar(254)
  phone                String?   @db.VarChar(15)
  npi                  String?   @unique @db.VarChar(10)
  role                 String?   @db.VarChar(30)
  secondary_role       String?   @db.VarChar(30)
  permission           String?   @db.VarChar(100)
  language             String?   @db.VarChar(20)
  timezone             String?   @db.VarChar
  picture              String?   @db.Text
  status               String?   @db.VarChar(20)
  speciality           Json?     @db.Json
  provider_type        String?   @db.VarChar(255)
  year_of_experience   String?   @db.VarChar(10)
  bio                  String?   @db.Text
  state_license        String?   @db.VarChar(50)
  license_number       String?   @db.VarChar(50)
  taxonomyCode         String?   @db.VarChar(100)
  caller_id            String?   @db.VarChar(15)
  caller_id_verified   Boolean?  @default(false)
  dynamic_caller_ids   Json?     @db.Json
  is_partner           Boolean?  @default(false)
  is_clinical_manager  Boolean   @default(false)
  is_auto_timelog      Boolean?  @default(false)
  auto_timelog_message String?   @db.VarChar
  is_role_changed      Boolean?  @default(false)
  is_deleted           Boolean?  @default(false)
  deleted_at           DateTime? @db.Timestamptz
  deleted_reason       String?   @db.VarChar(255)
  user_id              BigInt?   @unique
  added_by_id          BigInt?
  deleted_by_id        BigInt?

  user       User?                 @relation("provider_user", fields: [user_id], references: [id])
  added_by   User?                 @relation("provider_added_by", fields: [added_by_id], references: [id])
  deleted_by User?                 @relation("provider_deleted_by", fields: [deleted_by_id], references: [id])
  groups     ProviderGroupMember[]

  task_type          TaskType[]
  consent_created_by Consent[]  @relation("consent_created_by")
  consent_deleted_by Consent[]  @relation("consent_deleted_by")
  careplan           CarePlan[]

  care_manager_for       PatientCareManager[]
  prescribed_medications PatientMedication[]
  assessments            Assessment[]
  assigned_tasks         Task[]                   @relation("task_assignee")
  created_tasks          Task[]                   @relation("task_assigned_by")
  education_materials    EducationMaterial[]
  assigned_educations    PatientEducationMaterial[]
  education_sends        EducationSchedule[]      @relation("education_send_by")
  education_cancels      EducationSchedule[]      @relation("education_cancelled_by")
  education_schedules    EducationSchedule[]      @relation("education_scheduled_by")

  sessions_hosted               Session[]                        @relation("session_host")
  sessions_created              Session[]                        @relation("session_created_by")
  encounters                    PatientEncounter[]               @relation("encounter_provider")
  encounter_details             PatientEncounterDetail[]         @relation("encounter_detail_provider")
  call_recordings               GeneralCallRecording[]           @relation("call_recording_provider")
  transfer_calls                ProviderGroupTransferCall[]      @relation("transfer_call_provider")
  appointments                  Appointment[]                    @relation("appointment_provider")
  availabilities                Availability[]                   @relation("availability_provider")
  vital_alerts_assigned         VitalAlert[]                     @relation("vital_alert_assign_to")
  vital_alert_links             VitalAlertProvider[]             @relation("vital_alert_provider")
  vital_review_notes            VitalReviewNote[]                @relation("vital_review_note_reviewed_by")
  vital_configurations          VitalConfiguration[]             @relation("vital_configuration_assign_to")
  alerts_assigned_to            Alert[]                          @relation("alert_assigned_to")
  alerts_assigned_by            Alert[]                          @relation("alert_assigned_by")
  alerts_resolved               Alert[]                          @relation("alert_resolved_by")
  time_logs_by                  TimeLog[]                        @relation("time_log_by")
  time_logs_performed           TimeLog[]                        @relation("time_log_performed_by")
  time_logs_deleted             TimeLog[]                        @relation("time_log_deleted_by")
  reset_time_logs               ResetTimeLog[]                   @relation("reset_time_log_provider")
  patient_care_plans_added      PatientCarePlan[]                @relation("patient_care_plan_added_by")
  patient_care_plans_signed_off PatientCarePlan[]                @relation("patient_care_plan_sign_off_by")
  patient_care_plans_stopped    PatientCarePlan[]                @relation("patient_care_plan_stoped_by")
  patient_care_plans_discarded  PatientCarePlan[]                @relation("patient_care_plan_discard_by")
  care_plan_responses_discarded CarePlanResponse[]               @relation("care_plan_response_discard_by")
  care_plan_progress_updated    CarePlanProgress[]               @relation("care_plan_progress_updated_by")
  care_plan_progress_discarded  CarePlanProgress[]               @relation("care_plan_progress_discard_by")
  provider_reviews              CarePlanProviderReview[]         @relation("provider_review_reviewed_by")
  monthly_updates_updated       CarePlanMonthlyUpdate[]          @relation("monthly_update_updated_by")
  monthly_updates_deleted       CarePlanMonthlyUpdate[]          @relation("monthly_update_deleted_by")
  review_drafts                 CarePlanProviderReviewDraft[]    @relation("review_draft_added_by")
  review_notes_added            CarePlanProviderReviewNote[]     @relation("review_note_added_by")
  review_notes_deleted          CarePlanProviderReviewNote[]     @relation("review_note_deleted_by")
  progress_history_updated      CarePlanProgressHistory[]        @relation("progress_history_updated_by")
  progress_history_deleted      CarePlanProgressHistory[]        @relation("progress_history_deleted_by")
  personal_progress_updated     PersonalProgress[]               @relation("personal_progress_updated_by")
  personal_progress_discarded   PersonalProgress[]               @relation("personal_progress_discard_by")
  personal_history_updated      PersonalProgressHistory[]        @relation("personal_history_updated_by")
  personal_history_deleted      PersonalProgressHistory[]        @relation("personal_history_deleted_by")
  questionnaire_responses       ConditionQuestionnaireResponse[] @relation("questionnaire_completed_by")
  patient_reports_sent          CarePlanPatientReport[]          @relation("patient_report_send_by")
  assessments_scheduled         AssignedAssessment[]             @relation("assigned_assessment_scheduled_by")
  screenings_scheduled          Screening[]                      @relation("screening_scheduled_by")
  screening_reviews             ScreeningReview[]                @relation("screening_review_by")
  overall_responses_reviewed    AssessmentOverallResponse[]      @relation("overall_response_review_by")
  enrollments_unenrolled        Enrollment[]                     @relation("enrollment_unenrolled_by")
  enrollments_declined          Enrollment[]                     @relation("enrollment_declined_by")
  enrollments_updated           Enrollment[]                     @relation("enrollment_updated_by")
  documents_created             PatientDocument[]                @relation("document_created_by")
  documents_modified            PatientDocument[]                @relation("document_modified_by")
  documents_archived            PatientDocument[]                @relation("document_archived_by")
  documents_unarchived          PatientDocument[]                @relation("document_unarchived_by")

  @@index([added_by_id])
  @@index([deleted_by_id])
  @@index([created_at])
  @@map("providers")
}

model ProviderGroupMember {
  id                BigInt    @id @default(autoincrement())
  created_at        DateTime? @default(now()) @db.Timestamptz
  provider_id       BigInt
  provider_group_id BigInt

  provider       Provider      @relation(fields: [provider_id], references: [id])
  provider_group ProviderGroup @relation(fields: [provider_group_id], references: [id])

  @@unique([provider_id, provider_group_id])
  @@index([provider_id])
  @@index([provider_group_id])
  @@map("provider_group_members")
}

model Condition {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @updatedAt @db.Timestamptz
  title       String?   @unique @db.VarChar(200)
  description String?   @db.VarChar(255)
  for_ccm     Boolean?  @default(false)
  for_pcm     Boolean?  @default(false)
  for_bhi     Boolean?  @default(false)
  for_rpm     Boolean?  @default(false)
  programs    Json?     @db.Json

  questions   ConditionQuestion[]
  icd_codes   IcdCode[]
  careplans   CarePlanCondition[]
  assessments AssessmentCondition[]

  patient_conditions  PatientCondition[]
  careplan_questions  CarePlanQuestion[]
  education_materials EducationMaterial[]
  education_material_links EducationMaterialCondition[]

  questionnaires ConditionQuestionnaire[]

  @@index([created_at])
  @@map("conditions")
}

model ConditionQuestion {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Uuid
  condition_id    BigInt
  created_at      DateTime? @default(now()) @db.Timestamptz
  updated_at      DateTime? @updatedAt @db.Timestamptz
  title           String?   @db.Text
  question_type   String?   @db.VarChar(50)
  choices         String?   @db.Text
  additional_note String?   @db.Text

  condition Condition @relation(fields: [condition_id], references: [id], onDelete: Cascade)

  @@index([condition_id])
  @@index([created_at])
  @@map("condition_questions")
}

/// Named and styled after `schema (2).prisma`. It has `employee_id`; we assign
/// to providers until the Employee/ProviderProfile split is resolved.
model Task {
  id                   BigInt    @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  patientId            BigInt?   @map("patient_id")
  title                String
  category             String?
  priority             String?
  description          String?
  status               String?
  dueDate              DateTime? @map("due_date") @db.Timestamptz(3)
  isCompleted          Boolean   @default(false) @map("is_completed")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  action               String?   @db.VarChar(20)
  patientNote          String?   @map("patient_note")
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  isBillable           Boolean   @default(true) @map("is_billable")
  assigneeId           BigInt?   @map("assignee_id")
  assignedById         BigInt?   @map("assigned_by_id")
  providerGroupId      BigInt?   @map("provider_group_id")
  reminderSet          Boolean   @default(false) @map("reminder_set")
  reminderSendToHost   Boolean   @default(false) @map("reminder_send_to_host")
  reminderMediums      Json?     @map("reminder_mediums")
  reminderBeforeNumber Int?      @map("reminder_before_number")
  reminderBeforeUnit   String?   @map("reminder_before_unit") @db.VarChar(20)
  reminderAt           DateTime? @map("reminder_at") @db.Timestamptz(3)
  reminderSent         Boolean   @default(false) @map("reminder_sent")

  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignee      Provider?      @relation("task_assignee", fields: [assigneeId], references: [id])
  assignedBy    Provider?      @relation("task_assigned_by", fields: [assignedById], references: [id])
  providerGroup ProviderGroup? @relation(fields: [providerGroupId], references: [id])

  sessionId BigInt?  @map("session_id")
  session   Session? @relation(fields: [sessionId], references: [id])

  @@index([patientId])
  @@index([assigneeId, isCompleted, dueDate])
  @@index([dueDate])
  @@index([providerGroupId])
  @@map("tasks")
}

model TaskType {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(255)
  is_billable       Boolean   @default(false)
  is_archived       Boolean   @default(false)
  provider_group_id BigInt?
  created_by_id     BigInt?

  provider_group ProviderGroup? @relation(fields: [provider_group_id], references: [id])
  created_by     Provider?      @relation(fields: [created_by_id], references: [id])

  @@index([provider_group_id])
  @@index([created_by_id])
  @@index([created_at])
  @@map("task_types")
}

model BulkCommunicationTemplate {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(255)
  subject           String?   @db.VarChar(255)
  template_body     String?   @db.Text
  template_type     String?   @db.VarChar(100)
  achieved          Boolean   @default(false)
  provider_group_id BigInt?
  created_by_id     BigInt?
  updated_by_id     BigInt?
  achieved_by_id    BigInt?

  provider_group  ProviderGroup?                     @relation(fields: [provider_group_id], references: [id])
  revisions       BulkCommunicationTemplateRevision[]
  care_plan_tasks CarePlanTask[]

  documents PatientDocument[]

  @@index([provider_group_id])
  @@index([template_type])
  @@index([created_at])
  @@map("bulk_communication_templates")
}

model BulkCommunicationTemplateRevision {
  id             String    @id @default(uuid()) @db.Uuid
  template_id    BigInt
  created_at     DateTime? @default(now()) @db.Timestamptz
  old_title      String?   @db.VarChar(255)
  new_title      String?   @db.VarChar(255)
  old_content    String?   @db.Text
  new_content    String?   @db.Text
  revision_by_id BigInt?

  template BulkCommunicationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@map("bulk_communication_template_revisions")
}

model Consent {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @default(uuid()) @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @updatedAt @db.Timestamptz
  title         String?   @db.VarChar(200)
  program       String?   @db.VarChar(100)
  file          String?   @db.Text
  created_by_id BigInt?
  deleted_by_id BigInt?
  deleted_at    DateTime? @db.Timestamptz
  is_deleted    Boolean   @default(false)

  created_by Provider? @relation("consent_created_by", fields: [created_by_id], references: [id])
  deleted_by Provider? @relation("consent_deleted_by", fields: [deleted_by_id], references: [id])

  documents PatientDocument[]

  @@index([program])
  @@index([created_at])
  @@map("consents")
}

model CarePlan {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(200)
  description       String?   @db.VarChar(255)
  support           Boolean   @default(false)
  allergies         Boolean   @default(false)
  medications       Boolean   @default(false)
  is_active         Boolean   @default(true)
  programs          Json?     @db.Json
  copied            Boolean   @default(false)
  copied_from_id    BigInt?
  creator_id        BigInt?
  provider_group_id BigInt?

  creator        Provider?      @relation(fields: [creator_id], references: [id])
  provider_group ProviderGroup? @relation(fields: [provider_group_id], references: [id])
  copied_from    CarePlan?      @relation("careplan_copied_from", fields: [copied_from_id], references: [id])
  copies         CarePlan[]     @relation("careplan_copied_from")

  patient_care_plans PatientCarePlan[]
  questions          CarePlanQuestion[]
  responses          CarePlanResponse[]
  progress           CarePlanProgress[]
  conditions         CarePlanCondition[]
  icd_codes          CarePlanIcdCode[]
  tasks              CarePlanTask[]

  vital_links               VitalCarePlan[]
  allergy_links             AllergyCarePlan[]
  medication_links          MedicationCarePlan[]
  lab_result_links          LabResultCarePlan[]
  provider_review_links     ProviderReviewCarePlan[]
  monthly_update_links      MonthlyUpdateCarePlan[]
  review_note_links         ProviderReviewNoteCarePlan[]
  number_to_track_links     NumberToTrackResponseCarePlan[]
  additional_note_links     AdditionalNoteCarePlan[]
  additional_notes          CarePlanAdditionalNote[]
  generic_response_links    GenericResponseCarePlan[]
  patient_report_links      PatientReportCarePlan[]
  review_drafts             CarePlanProviderReviewDraft[]
  common_question_responses CommonQuestionResponse[]

  @@index([title])
  @@index([creator_id])
  @@index([provider_group_id])
  @@index([copied_from_id])
  @@index([created_at])
