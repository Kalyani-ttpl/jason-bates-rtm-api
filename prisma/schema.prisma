  updated_by   Provider?         @relation("personal_history_updated_by", fields: [updated_by_id], references: [id])
  deleted_by   Provider?         @relation("personal_history_deleted_by", fields: [deleted_by_id], references: [id])

  @@index([progress_obj_id])
  @@map("personal_progress_histories")
}

model CommonQuestionResponse {
