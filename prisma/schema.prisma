/// Physician seconds bill 99424/99425, care-manager seconds 99426/99427.
model PcmBilling {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique @default(uuid()) @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz
  updated_at          DateTime? @updatedAt @db.Timestamptz
  time_spends         Float?    @default(0)
  pcm_time_spends     Float?    @default(0)
  month               Int?
  year                Int?
  billing_flag        String?   @db.VarChar(255)
  billing_status      String?   @default("pending") @db.VarChar(100)
  billable_date       DateTime? @db.Date
  submitted_at        DateTime? @db.Timestamptz
  submitted_cpt_codes Json?     @db.Json
  revenue             Float?    @default(0)
  complexity_type     String?   @db.VarChar(20)
  patient_id          BigInt

  patient       Patient                @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  time_logs     PcmBillingTimeLog[]
  pcm_time_logs PcmBillingPcmTimeLog[]
  notes         BillingNote[]

  @@unique([patient_id, month, year])
  @@index([patient_id])
  @@index([billing_status])
  @@index([month, year])
  @@map("pcm_billings")
}

model PcmBillingTimeLog {
  id            BigInt @id @default(autoincrement())
  pcmbilling_id BigInt
  timelog_id    BigInt

  pcm_billing PcmBilling @relation(fields: [pcmbilling_id], references: [id], onDelete: Cascade)
  time_log    TimeLog    @relation(fields: [timelog_id], references: [id], onDelete: Cascade)

  @@unique([pcmbilling_id, timelog_id])
  @@index([pcmbilling_id])
  @@index([timelog_id])
  @@map("pcm_billing_time_logs")
}

model PcmBillingPcmTimeLog {
  id            BigInt @id @default(autoincrement())
  pcmbilling_id BigInt
  timelog_id    BigInt

  pcm_billing PcmBilling @relation(fields: [pcmbilling_id], references: [id], onDelete: Cascade)
  time_log    TimeLog    @relation(fields: [timelog_id], references: [id], onDelete: Cascade)

  @@unique([pcmbilling_id, timelog_id])
  @@index([pcmbilling_id])
  @@index([timelog_id])
  @@map("pcm_billing_pcm_time_logs")
}

