  @@map("pcm_billing_pcm_time_logs")
}

model BillingNote {
  id             BigInt    @id @default(autoincrement())
  uuid           String    @unique @default(uuid()) @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz
  updated_at     DateTime? @updatedAt @db.Timestamptz
  billing_type   String?   @db.VarChar(50)
  note           String?   @db.Text
  old_status     String?   @db.VarChar(100)
  new_status     String?   @db.VarChar(100)
  created_by_id  BigInt?
  pcm_billing_id BigInt

  pcm_billing PcmBilling @relation(fields: [pcm_billing_id], references: [id], onDelete: Cascade)

  @@index([pcm_billing_id])
  @@index([created_at])
  @@map("billing_notes")
}

model EnrollmentDevice {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @default(uuid()) @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @updatedAt @db.Timestamptz
  device_name   String?   @db.VarChar(255)
  device_source String?   @db.VarChar(50)
  device_id     String?   @db.VarChar(255)
  enrollment_id BigInt

  enrollment Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id])
  @@map("enrollment_devices")
}

/// CPT 98975 — one-time setup, billable once the enrolment is active.
model EnrollmentBilling {
  id                     BigInt    @id @default(autoincrement())
  uuid                   String    @unique @default(uuid()) @db.Uuid
  created_at             DateTime? @default(now()) @db.Timestamptz
  updated_at             DateTime? @updatedAt @db.Timestamptz
  criteria               String?   @default("ENROLLMENT") @db.VarChar(20)
  service                String?   @db.VarChar(20)
  cpt_code               String?   @db.VarChar(10)
  bill_cycle_start_date  DateTime? @db.Timestamptz
  bill_cycle_end_date    DateTime? @db.Timestamptz
  current_month_year     String?   @db.VarChar(10)
  enrollment_status_type String?   @db.VarChar(20)
  paid_status            String?   @db.VarChar(50)
  claim_status           String?   @db.VarChar(50)
  submitted_at           DateTime? @db.Timestamptz
  deleted                Boolean?  @default(false)
  patient_id             BigInt
  enrollment_id          BigInt

  patient    Patient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([enrollment_id])
  @@index([service])
  @@index([current_month_year])
  @@index([claim_status])
  @@map("enrollment_billings")
}

/// CPT 98977 — billable when `days` reaches 16 within the 30-day cycle.
model MonitoringBilling {
  id                    BigInt    @id @default(autoincrement())
  uuid                  String    @unique @default(uuid()) @db.Uuid
  created_at            DateTime? @default(now()) @db.Timestamptz
  updated_at            DateTime? @updatedAt @db.Timestamptz
  criteria              String?   @default("DAY") @db.VarChar(20)
  service               String?   @db.VarChar(20)
  cpt_code              String?   @db.VarChar(10)
  days                  Int?      @default(0)
  new_updated_at        DateTime? @db.Timestamptz
  bill_cycle_start_date DateTime? @db.Timestamptz
  bill_cycle_end_date   DateTime? @db.Timestamptz
  current_month_year    String?   @db.VarChar(10)
  paid_status           String?   @db.VarChar(50)
  claim_status          String?   @db.VarChar(50)
  submitted_at          DateTime? @db.Timestamptz
  deleted               Boolean?  @default(false)
  patient_id            BigInt
  enrollment_id         BigInt

  patient    Patient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@index([patient_id])
  @@index([enrollment_id])
  @@index([service])
  @@index([days])
  @@index([bill_cycle_end_date])
  @@index([new_updated_at])
  @@map("monitoring_billings")
}

/// CPT derived from logged time: 98980 for 20-39 min, +98981 per 20-min block.
model InteractionBilling {
  id                    BigInt    @id @default(autoincrement())
  uuid                  String    @unique @default(uuid()) @db.Uuid
  created_at            DateTime? @default(now()) @db.Timestamptz
  updated_at            DateTime? @updatedAt @db.Timestamptz
  criteria              String?   @default("TIME") @db.VarChar(20)
  service               String?   @db.VarChar(20)
  current_month_year    String?   @db.VarChar(10)
  interaction_minutes   Int?
  cpt_codes             String?   @db.Text
  bill_cycle_start_date DateTime? @db.Timestamptz
  bill_cycle_end_date   DateTime? @db.Timestamptz
  paid_status           String?   @db.VarChar(50)
  claim_status          String?   @db.VarChar(50)
  submitted_at          DateTime? @db.Timestamptz
  complexity_type       String?   @db.VarChar(20)
  deleted               Boolean?  @default(false)
  patient_id            BigInt
  enrollment_id         BigInt

  patient    Patient    @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([patient_id, service, current_month_year])
  @@index([patient_id])
  @@index([enrollment_id])
  @@index([service])
  @@index([current_month_year])
  @@map("interaction_billings")
}

/// Each distinct calendar day with a row here increments MonitoringBilling.days.
model MonitoringData {
  id                   BigInt    @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz
  updated_at           DateTime? @updatedAt @db.Timestamptz
  vital                String?   @db.VarChar(50)
  actual_reading_one   String?   @db.VarChar(100)
  actual_reading_two   String?   @db.VarChar(100)
  actual_reading_three String?   @db.VarChar(100)
  device_reading       Json?     @db.Json
  reading_date         DateTime? @default(now()) @db.Timestamptz
  step_date            DateTime? @db.Date
  is_alert             Boolean?  @default(false)
  review_status        String?   @default("UNREVIEWED") @db.VarChar(20)
  reviewed_at          DateTime? @db.Timestamptz
  reviewed_by_id       BigInt?
  patient_id           BigInt
  enrollment_id        BigInt?

  patient    Patient     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id])

  @@index([patient_id])
  @@index([enrollment_id])
  @@index([reading_date])
  @@index([step_date])
  @@index([is_alert])
  @@map("monitoring_data")
}

