generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  BigInt    @id @default(autoincrement())
  uuid                String    @unique @default(uuid()) @db.Uuid
  email               String?   @unique @db.VarChar(254)
  passwordHash        String?   @map("password_hash") @db.VarChar(128)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  username    String?   @unique @db.VarChar(150)
  firstName   String?   @map("first_name") @db.VarChar(255)
  lastName    String?   @map("last_name") @db.VarChar(255)
  picture     String?   @db.Text
  dateJoined  DateTime? @default(now()) @map("date_joined") @db.Timestamptz
  isSuperuser Boolean?  @default(false) @map("is_superuser")
  isStaff     Boolean?  @default(false) @map("is_staff")
  isActive    Boolean?  @default(true) @map("is_active")
  isProvider  Boolean?  @default(false) @map("is_provider")
  isPatient   Boolean?  @default(false) @map("is_patient")
  isDeleted   Boolean?  @default(false) @map("is_deleted")

  addedBy   Provider[] @relation("provider_added_by")
  deletedBy Provider[] @relation("provider_deleted_by")
  provider  Provider?  @relation("provider_user")

  patient         Patient?
  emailAddresses  EmailAddress[]
  notifications   UserNotification[]
  chatParticipant ChatParticipant?

  @@map("users")
}

model IcdCode {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(200)
  description String?   @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  status         String  @default("active") @db.VarChar(20)
  isUnspecified  Boolean @default(false) @map("is_unspecified")
  isHipaaCovered String? @map("is_hipaa_covered") @db.VarChar(100)
  orderNumber    String? @map("order_number") @db.VarChar(255)
  conditionId    BigInt? @map("condition_id")

  condition Condition?         @relation(fields: [conditionId], references: [id])
  careplans CarePlanIcdCode[]

  @@index([description])
  @@index([status])
  @@index([conditionId])
  @@index([createdAt])
  @@map("icd_codes")
}

model CptCode {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  code        String?   @unique @db.VarChar(255)
  description String?   @db.VarChar(500)
  amount      String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  category     String? @db.VarChar(100)
  globalPeriod Int?    @map("global_period")
  status       String  @default("active") @db.VarChar(20)
  isFavorite   Boolean @default(false) @map("is_favorite")

  @@index([description])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@map("cpt_codes")
}

model Address {
  id         BigInt    @id @default(autoincrement())
  uuid       String    @unique @default(uuid()) @db.Uuid
  patientId  BigInt?   @map("patient_id")
  employeeId BigInt?   @map("employee_id")
  type       String?
  line1      String?
  line2      String?
  city       String?
  state      String?
  postalCode String?   @map("postal_code")
  country    String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient? @relation(fields: [patientId], references: [id])

  providerGroupsPhysical ProviderGroup[] @relation("physical_address")
  providerGroupsBilling  ProviderGroup[] @relation("billing_address")

  @@index([patientId])
  @@index([employeeId])
  @@index([city, state])
  @@index([postalCode])
  @@map("addresses")
}

model ProviderGroup {
  id                             BigInt    @id @default(autoincrement())
  uuid                           String    @unique @default(uuid()) @db.Uuid
  created_at                     DateTime? @default(now()) @db.Timestamptz
  updated_at                     DateTime? @updatedAt @db.Timestamptz
  group_name                     String?   @db.VarChar(255)
  group_npi                      String?   @unique @db.VarChar(10)
  code                           String?   @unique @db.VarChar(3)
  email                          String?   @db.VarChar(254)
  system_email                   String?   @unique @db.VarChar(254)
  system_email_verified          Boolean?  @default(false)
  phone                          String?   @db.VarChar(15)
  fax_id                         String?   @db.VarChar(20)
  website                        String?   @db.VarChar(200)
  speciality                     Json?     @db.Json
  status                         String?   @db.VarChar(10)
  picture                        String?   @db.Text
  bio                            String?   @db.Text
  caller_id                      String?   @db.VarChar(15)
  caller_id_verified             Boolean?  @default(false)
  physical_address_id            BigInt?
  billing_address_id             BigInt?
  device_vender_base_url         String?   @db.VarChar(200)
  show_revenue                   Boolean?  @default(false)
  timezone                       String?   @db.VarChar
  communication_logo             String?   @db.Text
  consent_logo                   String?   @db.Text
  report_logo                    String?   @db.Text
  disable_patient_emails         Boolean?  @default(false)
  disable_patient_notifications  Boolean?  @default(false)
  disable_patient_sms            Boolean?  @default(false)
  disable_provider_emails        Boolean?  @default(false)
  disable_provider_notifications Boolean?  @default(false)
  disable_provider_sms           Boolean?  @default(false)
  disable_patient_calls          Boolean?  @default(false)
  disable_call_recording         Boolean?  @default(false)

  physical_address Address? @relation("physical_address", fields: [physical_address_id], references: [id])
  billing_address  Address? @relation("billing_address", fields: [billing_address_id], references: [id])

  members                     ProviderGroupMember[]
  task_type                   TaskType[]
  bulk_communication_template BulkCommunicationTemplate[]
  careplan                    CarePlan[]

  patients                     Patient[]
  assessments                  Assessment[]
  education_materials          EducationMaterial[]
  additional_consent_templates AdditionalConsentTemplate[]
  roles                        Role[]

  @@index([physical_address_id])
  @@index([billing_address_id])
  @@index([created_at])
  @@map("provider_groups")
}

model Provider {
  id                   BigInt    @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  created_at           DateTime? @default(now()) @db.Timestamptz
  updated_at           DateTime? @updatedAt @db.Timestamptz
  first_name           String?   @db.VarChar(255)
  middle_name          String?   @db.VarChar(255)
  last_name            String?   @db.VarChar(255)
  display_name         String?   @db.VarChar(255)
  gender               String?   @db.VarChar(100)
  pronoun              String?   @db.VarChar(50)
  email                String?   @unique @db.VarChar(254)
  temparory_email      String?   @db.VarChar(254)
  phone                String?   @db.VarChar(15)
  npi                  String?   @unique @db.VarChar(10)
  role                 String?   @db.VarChar(30)
  secondary_role       String?   @db.VarChar(30)
  permission           String?   @db.VarChar(100)
  language             String?   @db.VarChar(20)
  timezone             String?   @db.VarChar
  picture              String?   @db.Text
  status               String?   @db.VarChar(20)
  speciality           Json?     @db.Json
  provider_type        String?   @db.VarChar(255)
  year_of_experience   String?   @db.VarChar(10)
  bio                  String?   @db.Text
  state_license        String?   @db.VarChar(50)
  license_number       String?   @db.VarChar(50)
  taxonomyCode         String?   @db.VarChar(100)
  caller_id            String?   @db.VarChar(15)
  caller_id_verified   Boolean?  @default(false)
  dynamic_caller_ids   Json?     @db.Json
  is_partner           Boolean?  @default(false)
  is_clinical_manager  Boolean   @default(false)
  is_auto_timelog      Boolean?  @default(false)
  auto_timelog_message String?   @db.VarChar
  is_role_changed      Boolean?  @default(false)
  is_deleted           Boolean?  @default(false)
  deleted_at           DateTime? @db.Timestamptz
  deleted_reason       String?   @db.VarChar(255)
  user_id              BigInt?   @unique
  added_by_id          BigInt?
  deleted_by_id        BigInt?

  user       User?                 @relation("provider_user", fields: [user_id], references: [id])
  added_by   User?                 @relation("provider_added_by", fields: [added_by_id], references: [id])
  deleted_by User?                 @relation("provider_deleted_by", fields: [deleted_by_id], references: [id])
  groups     ProviderGroupMember[]

  task_type          TaskType[]
  consent_created_by Consent[]  @relation("consent_created_by")
  consent_deleted_by Consent[]  @relation("consent_deleted_by")
  careplan           CarePlan[]

  care_manager_for       PatientCareManager[]
  prescribed_medications PatientMedication[]
  assessments            Assessment[]
  education_materials    EducationMaterial[]

  @@index([added_by_id])
  @@index([deleted_by_id])
  @@index([created_at])
  @@map("providers")
}

model ProviderGroupMember {
  id                BigInt    @id @default(autoincrement())
  created_at        DateTime? @default(now()) @db.Timestamptz
  provider_id       BigInt
  provider_group_id BigInt

  provider       Provider      @relation(fields: [provider_id], references: [id])
  provider_group ProviderGroup @relation(fields: [provider_group_id], references: [id])

  @@unique([provider_id, provider_group_id])
  @@index([provider_id])
  @@index([provider_group_id])
  @@map("provider_group_members")
}

model Condition {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz
  updated_at  DateTime? @updatedAt @db.Timestamptz
  title       String?   @unique @db.VarChar(200)
  description String?   @db.VarChar(255)
  for_ccm     Boolean?  @default(false)
  for_pcm     Boolean?  @default(false)
  for_bhi     Boolean?  @default(false)
  for_rpm     Boolean?  @default(false)
  programs    Json?     @db.Json

  questions   ConditionQuestion[]
  icd_codes   IcdCode[]
  careplans   CarePlanCondition[]
  assessments AssessmentCondition[]

  patient_conditions  PatientCondition[]
  careplan_questions  CarePlanQuestion[]
  education_materials EducationMaterial[]

  @@index([created_at])
  @@map("conditions")
}

model ConditionQuestion {
  id              BigInt    @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Uuid
  condition_id    BigInt
  created_at      DateTime? @default(now()) @db.Timestamptz
  updated_at      DateTime? @updatedAt @db.Timestamptz
  title           String?   @db.Text
  question_type   String?   @db.VarChar(50)
  choices         String?   @db.Text
  additional_note String?   @db.Text

  condition Condition @relation(fields: [condition_id], references: [id], onDelete: Cascade)

  @@index([condition_id])
  @@index([created_at])
  @@map("condition_questions")
}

model TaskType {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(255)
  is_billable       Boolean   @default(false)
  is_archived       Boolean   @default(false)
  provider_group_id BigInt?
  created_by_id     BigInt?

  provider_group ProviderGroup? @relation(fields: [provider_group_id], references: [id])
  created_by     Provider?      @relation(fields: [created_by_id], references: [id])

  @@index([provider_group_id])
  @@index([created_by_id])
  @@index([created_at])
  @@map("task_types")
}

model BulkCommunicationTemplate {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(255)
  subject           String?   @db.VarChar(255)
  template_body     String?   @db.Text
  template_type     String?   @db.VarChar(100)
  achieved          Boolean   @default(false)
  provider_group_id BigInt?
  created_by_id     BigInt?
  updated_by_id     BigInt?
  achieved_by_id    BigInt?

  provider_group  ProviderGroup?                     @relation(fields: [provider_group_id], references: [id])
  revisions       BulkCommunicationTemplateRevision[]
  care_plan_tasks CarePlanTask[]

  @@index([provider_group_id])
  @@index([template_type])
  @@index([created_at])
  @@map("bulk_communication_templates")
}

model BulkCommunicationTemplateRevision {
  id             String    @id @default(uuid()) @db.Uuid
  template_id    BigInt
  created_at     DateTime? @default(now()) @db.Timestamptz
  old_title      String?   @db.VarChar(255)
  new_title      String?   @db.VarChar(255)
  old_content    String?   @db.Text
  new_content    String?   @db.Text
  revision_by_id BigInt?

  template BulkCommunicationTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
  @@map("bulk_communication_template_revisions")
}

model Consent {
  id            BigInt    @id @default(autoincrement())
  uuid          String    @unique @default(uuid()) @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz
  updated_at    DateTime? @updatedAt @db.Timestamptz
  title         String?   @db.VarChar(200)
  program       String?   @db.VarChar(100)
  file          String?   @db.Text
  created_by_id BigInt?
  deleted_by_id BigInt?
  deleted_at    DateTime? @db.Timestamptz
  is_deleted    Boolean   @default(false)

  created_by Provider? @relation("consent_created_by", fields: [created_by_id], references: [id])
  deleted_by Provider? @relation("consent_deleted_by", fields: [deleted_by_id], references: [id])

  @@index([program])
  @@index([created_at])
  @@map("consents")
}

model CarePlan {
  id                BigInt    @id @default(autoincrement())
  uuid              String    @unique @default(uuid()) @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz
  updated_at        DateTime? @updatedAt @db.Timestamptz
  title             String?   @db.VarChar(200)
  description       String?   @db.VarChar(255)
  support           Boolean   @default(false)
  allergies         Boolean   @default(false)
  medications       Boolean   @default(false)
  is_active         Boolean   @default(true)
  programs          Json?     @db.Json
  copied            Boolean   @default(false)
  copied_from_id    BigInt?
  creator_id        BigInt?
  provider_group_id BigInt?

  creator        Provider?      @relation(fields: [creator_id], references: [id])
  provider_group ProviderGroup? @relation(fields: [provider_group_id], references: [id])
  copied_from    CarePlan?      @relation("careplan_copied_from", fields: [copied_from_id], references: [id])
  copies         CarePlan[]     @relation("careplan_copied_from")

  patient_care_plans PatientCarePlan[]
  questions          CarePlanQuestion[]
  responses          CarePlanResponse[]
  progress           CarePlanProgress[]
  conditions         CarePlanCondition[]
  icd_codes          CarePlanIcdCode[]
  tasks              CarePlanTask[]

  @@index([title])
  @@index([creator_id])
  @@index([provider_group_id])
  @@index([copied_from_id])
  @@index([created_at])
  @@map("care_plans")
}

model Patient {
  id                         BigInt    @id @default(autoincrement())
  uuid                       String    @unique @default(uuid()) @db.Uuid
  userId                     BigInt?   @unique @map("user_id")
  firstName                  String    @map("first_name")
  middleName                 String?   @map("middle_name")
  lastName                   String    @map("last_name")
  preferredName              String?   @map("preferred_name")
  dateOfBirth                DateTime? @map("date_of_birth") @db.Date
  gender                     String?
  phone                      String?
  phoneType                  String?   @map("phone_type")
  email                      String?   @unique
  preferredContactMethod     String?   @map("preferred_contact_method")
  preferredLanguage          String?   @map("preferred_language")
  pronoun                    String?
  race                       String?
  ethnicity                  String?
  secondaryPhone             String?   @map("secondary_phone")
  homePhone                  String?   @map("home_phone")
  workPhone                  String?   @map("work_phone")
  timezone                   String?
  pos                        String?
  notes                      String?
  registrationDate           DateTime? @map("registration_date") @db.Date
  referringProvider          String?   @map("referring_provider")
  preferredCommunication     String?   @map("preferred_communication_channel")
  disableCallRecording       Boolean   @default(false) @map("disable_call_recording")
  interpreterRequired        Boolean   @default(false) @map("interpreter_required")
  hasAdvancedDirective       Boolean   @default(false) @map("has_advanced_directive")
  hasPowerOfAttorney         Boolean   @default(false) @map("has_power_of_attorney")
  isActive                   Boolean   @default(true) @map("is_active")
  profilePicture             String?   @map("profile_picture")
  treatmentGoals             String[]  @map("treatment_goals")
  referringPhysician         String?   @map("referring_physician")
  referringPhysicianNumber   String?   @map("referring_physician_number")
  primaryCarePhysician       String?   @map("primary_care_physician")
  primaryCarePhysicianNumber String?   @map("primary_care_physician_number")
  hearAboutUs                String?   @map("hear_about_us")
  outsideRecordsConsent      Boolean   @default(false) @map("outside_records_consent")
  hipaa_notice               Boolean   @default(false) @map("hipaa_notice")
  treatment_consent          Boolean   @default(false) @map("treatment_consent")
  financial_consent          Boolean   @default(false) @map("financial_consent")
  signature                  String?   @map("signature")
  signature_date             DateTime? @map("signature_date") @db.Date
  printedFirstName           String?   @map("printed_first_name")
  printedMiddleName          String?   @map("printed_middle_name")
  printedLastName            String?   @map("printed_last_name")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  mrn                    String?   @map("mrn")
  status                 String?   @map("status")
  statusUpdatedAt        DateTime? @map("status_updated_at") @db.Timestamptz(3)
  inviteStatus           String?   @map("invite_status")
  invitedAt              DateTime? @map("invited_at") @db.Timestamptz(3)
  lastCallAt             DateTime? @map("last_call_at") @db.Timestamptz(3)
  lastCallStatus         String?   @map("last_call_status")
  riskLevel              String?   @map("risk_level")
  riskScore              Float?    @map("risk_score")
  cmsRiskScore           Float?    @map("cms_risk_score")
  cmsRiskTier            String?   @map("cms_risk_tier")
  riskStratificationBool Boolean?  @map("risk_stratification_bool")
  riskStratificationDate DateTime? @map("risk_stratification_date") @db.Timestamptz(3)
  riskStratificationFreq Int?      @map("risk_stratification_freq")
  maritalStatus          String?   @map("marital_status")
  isConsentToMessage     Boolean?  @default(false) @map("is_consent_to_message")
  isConsentToCall        Boolean?  @default(false) @map("is_consent_to_call")
  isConsentToEmail       Boolean?  @default(false) @map("is_consent_to_email")
  isPcmEligible          Boolean?  @default(false) @map("is_pcm_eligible")
  isRtmEligible          Boolean?  @default(false) @map("is_rtm_eligible")
  isSendConsentRtm       Boolean?  @default(false) @map("is_send_consent_rtm")
  isHeartEligible        Boolean?  @default(false) @map("is_heart_eligible")
  primaryPhysicianId     BigInt?   @map("primary_physician_id")
  primaryCareManagerId   BigInt?   @map("primary_care_manager_id")
  secondaryCareManagerId BigInt?   @map("secondary_care_manager_id")
  providerGroupId        BigInt?   @map("provider_group_id")
  isDeleted              Boolean?  @default(false) @map("is_deleted")

  user          User?          @relation(fields: [userId], references: [id])
  providerGroup ProviderGroup? @relation(fields: [providerGroupId], references: [id])

  addresses                 Address[]
  emergencyContacts         PatientEmergencyContact[]
  powerOfAttorney           PatientPowerOfAttorney?
  insurances                PatientInsurance[]
  imagings                  PatientImaging[]
  preferredPharmacies       PatientPreferredPharmacy[]
  allergies                 PatientAllergy[]
  patientMedications        PatientMedication[]
  patientSurgicalHistories  PatientSurgicalHistory[]
  patientMedicalHistories   PatientMedicalHistory[]
  patientSocialHistories    PatientSocialHistory[]
  patientDocuments          PatientDocument[]
  patientEducationMaterials PatientEducationMaterial[]

  caregiverContacts   PatientCaregiverContact[]
  patientConditions   PatientCondition[]
  careManagers        PatientCareManager[]
  symptoms            Symptom[]
  labResults          LabResult[]
  vitals              Vital[]
  vitalAlerts         VitalAlert[]
  vitalReviewNotes    VitalReviewNote[]
  enrollments         Enrollment[]
  patientCarePlans    PatientCarePlan[]
  carePlanResponses   CarePlanResponse[]
  carePlanProgress    CarePlanProgress[]
  providerReviews     CarePlanProviderReview[]
  monthlyUpdates      CarePlanMonthlyUpdate[]
  assignedAssessments AssignedAssessment[]
  screenings          Screening[]
  educationSchedules  EducationSchedulePatient[]
  smsRecords          SmsRecord[]
  timeLogs            TimeLog[]
  pcmBillings         PcmBilling[]

  enrollmentBillings  EnrollmentBilling[]
  monitoringBillings  MonitoringBilling[]
  interactionBillings InteractionBilling[]
  monitoringData      MonitoringData[]
  manualTimeEntries   ManualTimeEntry[]
  interactions        PatientInteraction[]
  activityTimelines   ActivityTimeline[]

  @@index([dateOfBirth])
  @@index([isActive, firstName, id])
  @@index([isActive, lastName, firstName])
  @@index([status])
  @@index([inviteStatus])
  @@index([providerGroupId])
  @@index([primaryPhysicianId])
  @@index([primaryCareManagerId])
  @@map("patients")
}

model PatientInsurance {
  id                    BigInt    @id @default(autoincrement())
  uuid                  String    @unique @default(uuid()) @db.Uuid
  patientId             BigInt    @map("patient_id")
  name                  String
  memberId              String?   @map("member_id")
  groupId               String?   @map("group_id")
  groupName             String?   @map("group_name")
  type                  String?
  cardFrontUrl          String?   @map("card_front_url")
  cardBackUrl           String?   @map("card_back_url")
  effectiveDate         DateTime? @map("effective_date") @db.Date
  expirationDate        DateTime? @map("expiration_date") @db.Date
  insuredFirstName      String?   @map("insured_first_name")
  insuredMiddleName     String?   @map("insured_middle_name")
  insuredLastName       String?   @map("insured_last_name")
  insuredDob            DateTime? @map("insured_dob") @db.Date
  relationshipToInsured String?   @map("relationship_to_insured")
  isWorkersCompOrAuto   Boolean   @default(false) @map("is_workers_comp_or_auto")
  claimNumber           String?   @map("claim_number")
  adjusterName          String?   @map("adjuster_name")
  adjusterPhone         String?   @map("adjuster_phone")
  rtmEligible           Boolean?  @default(true) @map("rtm_eligible")
  rtmNote               String?   @map("rtm_note")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([name])
  @@index([patientId, name])
  @@map("patient_insurances")
