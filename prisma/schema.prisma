  updated_at  DateTime? @updatedAt @db.Timestamptz
  report_file String?   @db.Text
  report_on   DateTime? @default(now()) @db.Timestamptz
  reviewed    Boolean?  @default(false)
  reviewed_at DateTime? @db.Timestamptz
